NODE_ENV=development
LOG_LEVEL=info
MCP_SERVER_NAME=terravox-blender-mcp
MCP_SERVER_VERSION=0.1.0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Blender Worker (B2) - runs on Linux, never on Vercel ---
# WORKER_ID=blender-worker-01
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_LEASE_SECONDS=60
# WORKER_HEARTBEAT_INTERVAL_MS=15000
# WORKER_MAX_ATTEMPTS=3
# WORKER_RETRY_DELAY_MS=5000
# WORKER_SHUTDOWN_GRACE_MS=30000
# WORKER_WORKSPACE_ROOT=/var/lib/terravox-blender-worker/workspaces
# WORKER_REQUIRE_BLENDER_AT_STARTUP=true
# BLENDER_PATH=/usr/bin/blender
# BLENDER_TIMEOUT_MS=120000
# BLENDER_MAX_OUTPUT_BYTES=262144
# BLENDER_MAX_RESULT_BYTES=1048576
# BLENDER_ASSETS_DIR=assets/blender
# BLENDER_SCRIPTS_DIR=tools/blender
