# Copy to /etc/terravox-blender-worker.env  (chmod 600, owner root)
NODE_ENV=production
LOG_LEVEL=info
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_SIDE_ONLY

WORKER_ID=blender-worker-01
BLENDER_PATH=/usr/bin/blender
BLENDER_TIMEOUT_MS=120000
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_GRACE_MS=30000
